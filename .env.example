# =============================================================================
# CareerPilot AI - Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values for your deployment.
#   cp .env.example .env
# =============================================================================

# --- Application ---
APP_NAME=CareerPilot AI
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-random-secret

# --- PostgreSQL Database ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=careerpilot
POSTGRES_PASSWORD=careerpilot_secret
POSTGRES_DB=careerpilot
#
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
DATABASE_URL_SYNC=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0

# --- Celery ---
CELERY_BROKER_URL=redis://${REDIS_HOST}:${REDIS_PORT}/1
CELERY_RESULT_BACKEND=redis://${REDIS_HOST}:${REDIS_PORT}/2

# --- Caddy ---
CADDY_EMAIL=admin@yourdomain.com
CADDY_ACME_CA=https://acme-v02.api.letsencrypt.org/directory

# --- JWT Authentication ---
JWT_SECRET_KEY=change-me-to-a-random-jwt-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- AI / LLM ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.7

# --- Vector Database (pgvector) ---
VECTOR_DIMENSION=1536
VECTOR_INDEX_TYPE=ivfflat
VECTOR_LISTS=100
VECTOR_PROBES=10

# --- File Storage ---
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage
STORAGE_MAX_FILE_SIZE=10485760
STORAGE_ALLOWED_EXTENSIONS=.pdf,.doc,.docx,.txt,.md,.json,.csv

# --- Email ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=noreply@yourdomain.com

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=

# --- Rate Limiting ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=/app/storage/logs/app.log

# --- Monitoring ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=${APP_ENV}
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090

# --- Feature Flags ---
FEATURE_MATCH_SCORE_ENABLED=true
FEATURE_COVER_LETTER_ENABLED=true
FEATURE_TELEGRAM_ENABLED=true
FEATURE_WEBHOOKS_ENABLED=true
