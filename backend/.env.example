# ── Application ──────────────────────────────────────────────
APP_NAME=CareerPilot AI
DEBUG=false
SECRET_KEY=change-me-to-a-long-random-string

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://careerpilot:careerpilot@localhost:5432/careerpilot
DATABASE_SYNC_URL=postgresql://careerpilot:careerpilot@localhost:5432/careerpilot

# ── Redis / Celery ───────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ── LLM Providers ────────────────────────────────────────────
GROQ_API_KEY=
GEMINI_API_KEY=

# ── Telegram ─────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=

# ── JWT ──────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# ── TOTP (2FA) ───────────────────────────────────────────────
TOTP_ISSUER_NAME=CareerPilot AI

# ── Celery Beat Schedule (IST = UTC+5:30) ────────────────────
# Discovery job runs at 08:00 IST = 02:30 UTC
CELERY_BEAT_DISCOVERY_HOUR=2
CELERY_BEAT_DISCOVERY_MINUTE=30
# Digest job runs at 09:00 IST = 03:30 UTC
CELERY_BEAT_DIGEST_HOUR=3
CELERY_BEAT_DIGEST_MINUTE=30
# Reminder job runs at 10:00 IST = 04:30 UTC
CELERY_BEAT_REMINDER_HOUR=4
CELERY_BEAT_REMINDER_MINUTE=30

# ── Embeddings ───────────────────────────────────────────────
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# ── Storage ──────────────────────────────────────────────────
UPLOAD_DIR=./uploads
STATIC_DIR=./static

# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=*
